<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkoutTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WorkoutTracker"
    xmlns:views="clr-namespace:WorkoutTracker.Views"
    Title="WorkoutTracker">

    <Shell.TitleView>
        <Grid>
            <Label x:Name="TitleLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="Exercises"
            ContentTemplate="{DataTemplate views:ExercisesListPage}"
            Route="ExercisesListPage" />
    </TabBar>
</Shell>
