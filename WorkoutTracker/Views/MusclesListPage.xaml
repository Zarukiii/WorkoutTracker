<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTracker.Views.MusclesListPage"
             Title="MusclesListPage">
    <Grid RowDefinitions="Auto, *, Auto">
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Muscles}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding MuscleSelectedCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" Padding="16,12,0,0"/>
                        <BoxView HeightRequest="1" Color="LightGray" Margin="16,0"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>