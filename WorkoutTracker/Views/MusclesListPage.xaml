<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:WorkoutTracker.Styles"
             x:Class="WorkoutTracker.Views.MusclesListPage"
             Title="MusclesListPage">
    <Grid RowDefinitions="Auto, *, Auto">
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Muscles}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding MuscleSelectedCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto, *, Auto"
                              Padding="16,0"
                              HeightRequest="52"
                              ColumnSpacing="12">

                            <Label Grid.Column="0"
                                   Text="{x:Static local:MaterialIcons.Favorite}"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="2"
                                   Text="{x:Static local:MaterialIcons.Chevron}"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Gray400}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="LightGray" Margin="16,0"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>