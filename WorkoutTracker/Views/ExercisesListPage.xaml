<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:WorkoutTracker.Styles"
             xmlns:vm="clr-namespace:WorkoutTracker.ViewModels"
             x:Class="WorkoutTracker.Views.ExercisesListPage"
             Title="Exercises">
    <Grid RowDefinitions="Auto, *, Auto">
        <Border StrokeShape="RoundRectangle 12"
                Stroke="Transparent"
                BackgroundColor="#F2F2F2"
                Margin="16,8">
            <SearchBar Text="{Binding SearchText}"
                       Grid.Row="0"
                       Placeholder="Search exercises"
                       SearchIconColor="Black"
                       CancelButtonColor="Black"
                       TextColor="Black"
                       Margin="12,0" />
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Exercises}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding ExerciseSelectedCommand}"
                        SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="40, *, 24"
                              Padding="16, 0"
                              HeightRequest="52"
                              ColumnSpacing="12">
                            
                            <Label Grid.Column="0"
                                   Text="{Binding FavoriteGlyph}"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExerciseViewModel}}, Path=ToggleFavoriteCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center">
                                <Label FontSize="16"
                                       Text="{Binding Name}"
                                       LineBreakMode="TailTruncation" />

                                <Label FontSize="12"
                                       Text="{Binding Subtitle}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="{x:Static local:MaterialIcons.Chevron}"
                                   FontFamily="MaterialIcons"
                                   TextColor="{StaticResource Gray400}"
                                   VerticalOptions="Center" />

                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="LightGray" Margin="16,0"/>
                        
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"/>

        <Button Grid.Row="2"
                Text="Add exercise"
                Command="{Binding AddExerciseCommand}"
                Margin="16"/>
    </Grid>
</ContentPage>